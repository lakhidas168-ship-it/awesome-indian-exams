# Hive schedule for the owner's Mac. Install with:  crontab -e   (paste, then fix REPO and the two commands)
# Hermes and OpenCode start together at :05 and run in parallel (separate worktrees, atomic task claims).
# JEVX reviews, plans and merges at :40, after the workers have opened their PRs.
# Logs: ~/.hive/<lane>.log.   The Mac must be awake (cron does not run during sleep).
#
# One-time login (task H-001):  gh auth login
#
# HIVE_CMD_* is the command that runs each agent non-interactively; the runner appends the prompt as the
# last argument. "opencode run <prompt>" is OpenCode's non-interactive mode. Set the Hermes and JEVX
# commands to whatever your installs use to run a single prompt and exit.

PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
REPO=/Users/you/code/lakhidas168-ship-it
HIVE_CMD_OPENCODE=opencode run
HIVE_CMD_HERMES=REPLACE_WITH_HERMES_ONE_SHOT_COMMAND
HIVE_CMD_JEVX=REPLACE_WITH_JEVX_ONE_SHOT_COMMAND

5  * * * *  mkdir -p "$HOME/.hive" && cd "$REPO" && awesome-engineering-exams/ops/run-hourly.sh hermes   >> "$HOME/.hive/hermes.log"   2>&1
5  * * * *  mkdir -p "$HOME/.hive" && cd "$REPO" && awesome-engineering-exams/ops/run-hourly.sh opencode >> "$HOME/.hive/opencode.log" 2>&1
40 * * * *  mkdir -p "$HOME/.hive" && cd "$REPO" && awesome-engineering-exams/ops/run-hourly.sh jevx     >> "$HOME/.hive/jevx.log"     2>&1
